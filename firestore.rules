rules_version = '2';

// Firestore cerrado por completo (2026-10-26, spec-app-finanzas-v2.md
// §4.2.1): la app no guarda datos de usuarios en servidores propios. El
// respaldo opcional vive en el Google Drive de cada usuario, así que nadie
// —ni con sesión iniciada— puede leer ni escribir aquí.
//
// El diseño de reglas por cuenta y roles (presupuesto compartido, §7) se
// conserva como referencia en docs/firestore-reglas-diseno.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
