<?xml version="1.0" encoding="utf-8"?>
<!--
    android:allowBackup="false" ya desactiva copia en la nube y transferencia
    entre dispositivos por completo (regla dura: los datos financieros del
    usuario no salen del dispositivo sin su acción explícita — ver "Exportar
    mis gastos" en Ajustes). Este archivo queda vacío y sin excepciones por
    si algún día allowBackup cambia a true: que la ausencia de reglas no
    habilite un backup completo por accidente.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
